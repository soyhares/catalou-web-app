# Ambiente de desarrollo LOCAL — copiar a `.env` y correr.
#
# Producción vive en `.env.prod` y se usa solo de forma explícita:
#   pnpm build --mode prod
#
# Ver ADR-030 en catalou-platform-core.

# ─── API ──────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000

# ─── Supabase (Auth only) ─────────────────────────────────────────────────────
# GoTrue del stack local (npx supabase start en catalou-api-core).
# Apuntar esto a la nube con la API en local rompe toda sesión: el JWT lo emite
# un Auth y lo valida el otro.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ─── PWA / Subdomain Resolution ───────────────────────────────────────────────
VITE_CATALOU_DOMAIN=catalou.com

# Slug del tenant para pruebas locales — reemplaza la resolución por subdominio.
# Siempre `demo`: el QA no se corre contra negocios reales (ADR-030).
VITE_DEV_SLUG=demo

# ─── Catalog Domain ───────────────────────────────────────────────────────────
VITE_CATALOG_DOMAIN=catalou.com

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Debe coincidir con VAPID_PUBLIC_KEY en catalou-api-core.
VITE_VAPID_PUBLIC_KEY=
